@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam defaultTextAlignment center
skinparam roundCorner 8
skinparam shadowing false
skinparam ranksep 18
skinparam nodesep 28
skinparam arrowThickness 1.3

skinparam package {
    BorderColor transparent
    BackgroundColor transparent
}

skinparam node {
    BackgroundColor #F7FAFC
    BorderColor #4A5568
    FontStyle bold
}

skinparam component {
    BackgroundColor #FFFFFF
    BorderColor #718096
    FontColor #2D3748
}

skinparam file {
    BackgroundColor #EDF2F7
    BorderColor #4A5568
    FontColor #1A202C
    FontStyle bold
}

' Columna izquierda: Nodo maestro en rectangulo vertical con altura compacta
node "Nodo maestro - Rank 0" as MasterNode #EBF8FF {
    file "input.txt" as IN
    [          Lector y particionador de carga          ] as Part
    [          Motor de evaluación en memoria:\nparser, scorer, rules          ] as MasterEval
    [          Colector y ordenador de resultados          ] as Sorter
    file "salida.txt" as OUT
    
    IN -down-> Part : Lectura local
    Part -down-> MasterEval : Porción local
    MasterEval -down-> Sorter : Resultados locales
    Sorter -down-> OUT : Escritura local
}

' Columna derecha: Tres trabajadores apilados en torre
package " " as Workers {
    node "Nodo trabajador 1 - Rank 1" as W1Node #F0FFF4 {
        [          Motor de evaluación en memoria:\nparser, scorer, rules          ] as W1Eval
    }

    node "Nodo trabajador 2 - Rank 2" as W2Node #F0FFF4 {
        [          Motor de evaluación en memoria:\nparser, scorer, rules          ] as W2Eval
    }

    node "Nodo trabajador N - Rank N" as WNNode #F0FFF4 {
        [          Motor de evaluación en memoria:\nparser, scorer, rules          ] as WNEval
    }

    W1Node -[hidden]down-> W2Node
    W2Node -[hidden]down-> WNNode
}

MasterNode -[hidden]right-> Workers

' Dispersión de datos (scatter) en azul con destino identificado
Part -[#1E88E5]-> W1Eval : comm.scatter a Rank 1
Part -[#1E88E5]-> W2Eval : comm.scatter a Rank 2
Part -[#1E88E5]-> WNEval : comm.scatter a Rank N

' Recolección de datos (gather) en verde con origen identificado
W1Eval -[#2E7D32]-> Sorter : comm.gather de Rank 1
W2Eval -[#2E7D32]-> Sorter : comm.gather de Rank 2
WNEval -[#2E7D32]-> Sorter : comm.gather de Rank N

@enduml

